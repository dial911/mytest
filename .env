HF_ENDPOINT=https://hf-mirror.com
CHROMA_DB_PATH=./chroma_db

API_TIMEOUT=180
API_MAX_RETRIES=3
API_RETRY_DELAY=2

HF_HUB_DOWNLOAD_TIMEOUT=300
EMBEDDING_MODEL_NAME=shibing624/text2vec-base-chinese
# EMBEDDING_MODEL_NAME=moka-ai/m3e-base
RERANK_MODEL_NAME=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# 若模型本身需要自定义代码(trust_remote_code=true)时打开，默认关闭更安全
EMBEDDING_MODEL_TRUST_REMOTE=false

# === LLM 配置 (已切换为 DeepSeek，任何 OpenAI 兼容 API 都可用) ===
# -- 默认 DeepSeek --
# LLM_PROVIDER=deepseek
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=
LLM_MAX_TOKENS=4096
# 申请地址: https://platform.deepseek.com
# 也兼容 OPENAI_API_KEY 命名
# DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# 其他常用兼容接口（复制到 .env 修改即可，无需改代码）:
# -- Moonshot (Kimi) : 新号免费额度默认只开启 kimi-k2 系列 --
LLM_PROVIDER=moonshot
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_MODEL=kimi-k2.6
DEEPSEEK_API_KEY=sk-ZYyM6VOIrT6C3fEpec8xbH66VIecxE8qxtVTReqtXbXf2EuB
# 备用模型:
# LLM_MODEL=kimi-k2.7-code
#
# -- 智谱 AI (GLM) --
# LLM_PROVIDER=zhipu
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash
# DEEPSEEK_API_KEY=your-zhipu-apikey-here
#
# -- 硅基流动 (SiliconFlow) --
# LLM_PROVIDER=siliconflow
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=deepseek-ai/DeepSeek-V2.5
# DEEPSEEK_API_KEY=sk-your-siliconflow-key

# === 代理配置 ===
# 三选一，Clash/V2Ray 默认通常 HTTP=7890，SOCKS=7891。
# 注意：DeepSeek 国内可直连，通常无需代理；但下载 HuggingFace 模型时如果慢，建议仍开启。
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5h://127.0.0.1:7891
HTTP_PROXY=http://127.0.0.1:10808
HTTPS_PROXY=http://127.0.0.1:10808
